# Postinstall-Skripte (native Builds) beim Installieren überspringen.
# better-sqlite3 wird NICHT gegen System-Node gebaut, sondern separat gegen
# die Electron-ABI (siehe "rebuild"-Skript). Das vermeidet den node-gyp-Build
# gegen Node und nutzt vorgefertigte Prebuilds – ohne Python/MSVC.
ignore-scripts=true
fund=false
audit=false
